        <!-- 6. Wordmark & Tagline -->
        <Node x="250" y="380" name="WordmarkGroup" id="0:300">
            <Text x="0" y="0" originX="0.5" originY="0.5" alignValue="center" name="BrandTitle" id="0:301" opacity="0">
                <TextStylePaint fontSize="32" fontAssetId="0:100" name="SmartStyle" id="0:302">
                    <Fill name="Fill"><SolidColor colorValue="FFEAF3FF" name="Navy"/></Fill>
                </TextStylePaint>
                <TextStylePaint fontSize="32" fontAssetId="0:100" name="TransitStyle" id="0:303">
                    <Fill name="Fill"><SolidColor colorValue="FF0A66C2" name="Blue"/></Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:302" text="SMART " name="RunSmart"/>
                <TextValueRun styleId="0:303" text="TRANSIT" name="RunTransit"/>
            </Text>

            <Text x="0" y="36" originX="0.5" originY="0.5" alignValue="center" name="Tagline" id="0:310" opacity="0">
                <TextStylePaint fontSize="13.5" fontAssetId="0:101" name="TaglineStyle" id="0:311">
                    <Fill name="Fill"><SolidColor colorValue="FFAFC2DA" name="NavyText"/></Fill>
                </TextStylePaint>
                <TextValueRun styleId="0:311" text="Intelligent Mobility. Connected Botswana." name="RunTagline"/>
            </Text>
        </Node>

        <!-- State Machine & Controller Wiring -->
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineBool name="appReady" id="0:10"/>
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="0" y="-150"/>
                <ExitState x="700" y="0" id="0:19"/>
                <EntryState>
                    <StateTransition stateToId="0:11"/>
                </EntryState>
                <!-- 1. Static (0ms, native OS launch screen match) -->
                <AnimationState x="100" y="0" animationId="0:51" id="0:11">
                    <StateTransition stateToId="0:12" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <!-- 2. TraceAndConnect (0-700ms, S-outline draw + node pulses) -->
                <AnimationState x="250" y="0" animationId="0:52" id="0:12">
                    <StateTransition stateToId="0:13" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <!-- 3. Arrival (700-900ms, Pin single arrival pulse) -->
                <AnimationState x="400" y="0" animationId="0:53" id="0:13">
                    <StateTransition stateToId="0:14" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <!-- 4. Wordmark (900-1100ms, Wordmark & tagline opacity fade-in) -->
                <AnimationState x="550" y="0" animationId="0:54" id="0:14">
                    <StateTransition stateToId="0:15" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>
                <!-- 5. Idle (1100ms onward, Pin subtle breathing pulse loop, waits for appReady) -->
                <AnimationState x="700" y="-150" animationId="0:55" id="0:15">
                    <StateTransition stateToId="0:19">
                        <TransitionBoolCondition inputId="0:10" opValue="equal"/>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- Timelines -->
        <!-- 1. Static (t=0ms, matches native launch screen perfectly) -->
        <LinearAnimation duration="1" name="Static" id="0:51">
            <KeyedObject objectId="0:211">
                <KeyedProperty propertyKey="115">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:300">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- 2. TraceAndConnect (0-700ms, 42 frames @ 60fps) -->
        <LinearAnimation duration="105" name="TraceAndConnect" id="0:52">
  <KeyedObject objectId="0:211"><KeyedProperty propertyKey="115"><KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.32" y1="0" x2="0.18" y2="1"/></KeyFrameDouble><KeyFrameDouble value="1" frame="105" interpolationType="cubic"><CubicEaseInterpolator x1="0.22" y1="0" x2="0.25" y2="1"/></KeyFrameDouble></KeyedProperty></KeyedObject>
  <KeyedObject objectId="0:220"><KeyedProperty propertyKey="16"><KeyFrameDouble value="1" frame="0" interpolationType="cubic"/><KeyFrameDouble value="1" frame="22" interpolationType="cubic"/><KeyFrameDouble value="0.06" frame="27" interpolationType="cubic"/><KeyFrameDouble value="1.12" frame="31" interpolationType="cubic"/><KeyFrameDouble value="1" frame="36" interpolationType="cubic"/></KeyedProperty><KeyedProperty propertyKey="17"><KeyFrameDouble value="1" frame="0" interpolationType="cubic"/><KeyFrameDouble value="1.08" frame="31" interpolationType="cubic"/><KeyFrameDouble value="1" frame="36" interpolationType="cubic"/></KeyedProperty></KeyedObject>
  <KeyedObject objectId="0:221"><KeyedProperty propertyKey="37"><KeyFrameColor value="FF0F1B2E" frame="0" interpolationType="linear"/><KeyFrameColor value="FF0F1B2E" frame="25" interpolationType="linear"/><KeyFrameColor value="FF22C8FF" frame="31" interpolationType="linear"/><KeyFrameColor value="FF22C8FF" frame="105" interpolationType="linear"/></KeyedProperty></KeyedObject>
  <KeyedObject objectId="0:230"><KeyedProperty propertyKey="16"><KeyFrameDouble value="1" frame="0" interpolationType="cubic"/><KeyFrameDouble value="1" frame="47" interpolationType="cubic"/><KeyFrameDouble value="0.06" frame="52" interpolationType="cubic"/><KeyFrameDouble value="1.12" frame="56" interpolationType="cubic"/><KeyFrameDouble value="1" frame="61" interpolationType="cubic"/></KeyedProperty><KeyedProperty propertyKey="17"><KeyFrameDouble value="1" frame="0" interpolationType="cubic"/><KeyFrameDouble value="1.08" frame="56" interpolationType="cubic"/><KeyFrameDouble value="1" frame="61" interpolationType="cubic"/></KeyedProperty></KeyedObject>
