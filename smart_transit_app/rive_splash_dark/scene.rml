</LinearAnimation>

        <!-- 3. Arrival (700-900ms, 12 frames @ 60fps) -->
        <LinearAnimation duration="18" name="Arrival" id="0:53">
  <KeyedObject objectId="0:211"><KeyedProperty propertyKey="115"><KeyFrameDouble value="1" frame="0" interpolationType="cubic"/></KeyedProperty></KeyedObject>
    <KeyedObject objectId="0:253"><KeyedProperty propertyKey="37"><KeyFrameColor value="FF0A66C2" frame="0" interpolationType="linear"/><KeyFrameColor value="FF22C8FF" frame="5" interpolationType="cubic"/></KeyedProperty></KeyedObject>
