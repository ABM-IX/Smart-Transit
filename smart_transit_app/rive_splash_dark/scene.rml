<Rive version="1" kind="fragment">
    <FontAsset file="SpaceGrotesk.ttf" name="SpaceGrotesk" id="0:100"/>
    <FontAsset file="Inter.ttf" name="Inter" id="0:101"/>

    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="500" height="600" name="Artboard" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>
        <Fill name="Background">
            <SolidColor colorValue="FF0A1424" name="NavyBg"/>
        </Fill>

        <!-- DRAW ORDER IN RIVE: First sibling declared draws ON TOP -->

        <!-- 1. Location Pin (Top Layer) -->
        <Node x="361.72" y="134.06" name="LocationPin" id="0:250">
            <!-- White Center Cutout (Draws on TOP of PinBody) -->
            <Shape x="0" y="-2" name="PinCutout" id="0:252">
                <Ellipse originX="0.5" originY="0.5" width="10" height="10"/>
                <Fill name="Fill"><SolidColor colorValue="FF0A1424" name="NavyCutout"/></Fill>
            </Shape>
            <!-- Pin Body Shape -->
            <Shape x="0" y="0" name="PinBody" id="0:251">
                <PointsPath isClosed="true" name="Path">
                    <CubicDetachedVertex x="0" y="-14" inRotation="3.14159" inDistance="7.5" outRotation="0" outDistance="7.5"/>
                    <CubicDetachedVertex x="13.5" y="-2" inRotation="-1.5708" inDistance="6.5" outRotation="1.8" outDistance="6.5"/>
                    <StraightVertex x="0" y="22" radius="1"/>
                    <CubicDetachedVertex x="-13.5" y="-2" inRotation="1.34" inDistance="6.5" outRotation="-1.5708" outDistance="6.5"/>
                </PointsPath>
                <Fill name="Fill"><SolidColor colorValue="FF0A66C2" name="PinBlue" id="0:253"/></Fill>
            </Shape>
        </Node>

        <!-- 2. Network Nodes (Draw on top of Circuit Line) -->
        <!-- Network Node 1 (Top) -->
        <Shape x="292.94" y="157.62" name="Node1" id="0:240">
            <Ellipse originX="0.5" originY="0.5" width="12" height="12"/>
            <Fill name="Fill"><SolidColor colorValue="FF496584" name="Node1Navy" id="0:241"/></Fill>
        </Shape>

        <!-- Network Node 2 (Middle) -->
        <Shape x="330.18" y="234.0" name="Node2" id="0:230">
            <Ellipse originX="0.5" originY="0.5" width="12" height="12"/>
            <Fill name="Fill"><SolidColor colorValue="FF496584" name="Node2Navy" id="0:231"/></Fill>
        </Shape>

        <!-- Network Node 3 (Bottom) -->
        <Shape x="319.54" y="292.33" name="Node3" id="0:220">
            <Ellipse originX="0.5" originY="0.5" width="12" height="12"/>
            <Fill name="Fill"><SolidColor colorValue="FF496584" name="Node3Navy" id="0:221"/></Fill>
        </Shape>

        <!-- 3. Cerulean S-Circuit Line (Stroke & Trim Animation) -->
        <Shape x="0" y="0" name="SCircuitTrace" id="0:210">
            <PointsPath isClosed="false" name="Path">
                <!-- 1. Start at bottom -->
                <CubicDetachedVertex x="199.27" y="310.38" outRotation="0.0" outDistance="25" inRotation="3.14" inDistance="0"/>
                <!-- 2. Through Node 3 -->
                <CubicDetachedVertex x="319.54" y="292.33" inRotation="3.35" inDistance="28" outRotation="-0.65" outDistance="25"/>
                <!-- 3. Bottom Right Loop -->
                <CubicDetachedVertex x="364.19" y="266.3" inRotation="1.57" inDistance="18" outRotation="-1.57" outDistance="18"/>
                <!-- 4. Through Node 2 -->
                <CubicDetachedVertex x="330.18" y="234.0" inRotation="-0.5" inDistance="20" outRotation="2.65" outDistance="25"/>
                <!-- 5. Center Diagonal Spine -->
                <CubicDetachedVertex x="216.37" y="186.5" inRotation="-0.55" inDistance="25" outRotation="2.6" outDistance="25"/>
                <!-- 6. Top Left Loop -->
                <CubicDetachedVertex x="195.47" y="169.4" inRotation="1.57" inDistance="16" outRotation="-0.3" outDistance="22"/>
                <!-- 7. Through Node 1 -->
                <CubicDetachedVertex x="292.94" y="157.62" inRotation="3.14" inDistance="26" outRotation="0.0" outDistance="20"/>
                <!-- 8. Connect to Location Pin -->
                <CubicDetachedVertex x="358.72" y="146.06" inRotation="3.14" inDistance="12" outRotation="0.0" outDistance="0"/>
            </PointsPath>
            <Stroke thickness="8" cap="round" join="round">
                <SolidColor colorValue="FF0A66C2" name="CeruleanBlue"/>
                <TrimPath start="0" end="0" name="Trim" id="0:211"/>
            </Stroke>
        </Shape>

        <!-- 4. Speed Trail Lines (Mobility) -->
        <Node name="SpeedTrails" id="0:200">
            <Shape x="155.95" y="222.03" name="SpeedLine1" id="0:201">
                <Rectangle originX="0.5" originY="0.5" width="50.9" height="9.1" cornerRadiusTL="4.5" linkCornerRadius="true"/>
                <Fill name="Fill"><SolidColor colorValue="FF0A66C2" name="Cerulean"/></Fill>
