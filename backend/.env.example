# SmartTransit AI Platform Configuration
PROJECT_NAME="SmartTransit AI Platform"
VERSION="2.0.0"
DEBUG=True

# Database (Default: local SQLite async, or Supabase Transaction Pooler: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres)
DATABASE_URL="sqlite+aiosqlite:///./smarttransit.db"

# Supabase API Configuration (Optional if directly using Postgres or for direct Auth / Realtime verification)
SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
SUPABASE_KEY="[YOUR-ANON-OR-SERVICE-KEY]"
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"

# Server Host & Port
PORT=8000
HOST="0.0.0.0"

# Transit Fare Rates (BWP)
TAXI_STANDARD_FARE=8.0
TAXI_SPECIAL_BASE=10.0
TAXI_SPECIAL_PER_KM=2.5
TAXI_SPECIAL_PER_MIN=0.5
BUS_COMBI_FARE=8.0
